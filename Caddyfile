# Plain HTTP on :2000. No domain, no TLS. Switch to `yourdomain.com { ... }`
# later to get automatic Let's Encrypt.
:2000 {
    encode zstd gzip

    # API: strip /api prefix and forward to the backend container.
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Frontend: static files mounted from the host into /srv.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
